---
// Open fonts (OFL), self-hosted through the build: nothing is fetched from a font CDN.
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@fontsource/newsreader/latin-600.css';
import headFont from '@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/kit.css';
import site from '../data/site.json';
const { title, description, slug = '', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/$/, '');
const href = s => `${base}/${s ? s + '/' : ''}`;
const isActive = s => (s ? here === `${base}/${s}` || here.startsWith(`${base}/${s}/`) : here === base);
const fullTitle = title && title !== site.name ? `${title} · ${site.name}` : `${site.name}${site.tagline ? ' · ' + site.tagline : ''}`;
const desc = description || site.description;
const abs = p => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = Astro.site ? abs(Astro.url.pathname) : undefined;
const ogImage = site.ogImage ? abs(`${base}/og.png`) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <style is:inline set:html={`@font-face{font-family:Inter;font-style:normal;font-weight:100 900;font-display:swap;src:url(${interFont}) format('woff2')}`}></style>
    <link rel="preload" href={headFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="wrap bar-in">
        <a class="mark" href={href('')}>{site.name}</a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />
        <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span><span></span></label>
        <nav class="nav" aria-label="Main">
          {site.nav.map(p => <a href={href(p.slug)} aria-current={isActive(p.slug) ? 'page' : undefined}>{p.title}</a>)}
          {site.cta && <a class="btn btn-sm" href={href(site.cta.slug)}>{site.cta.label}</a>}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand">
          <a class="mark" href={href('')}>{site.name}</a>
          {site.tagline && <p class="foot-tag">{site.tagline}</p>}
        </div>
        <nav class="foot-nav" aria-label="Footer">
          {site.footer.map(p => <a href={href(p.slug)}>{p.title}</a>)}
        </nav>
        <p class="foot-meta">{site.contact?.email && <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}<span>© {new Date().getFullYear()} {site.name}</span></p>
      </div>
    </footer>
  </body>
</html>
